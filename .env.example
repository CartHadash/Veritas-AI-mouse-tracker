# Copy this file to ".env" and put your real key after the = sign.
# The file ".env" is ignored by git, so the key never reaches GitHub.
ANTHROPIC_API_KEY=
# Only if the API says "This API key is not scoped to a workspace": the workspace ID
# (starts with wrkspc_, from console.anthropic.com > Workspaces). Not a secret.
ANTHROPIC_WORKSPACE_ID=
